# Copy this file to .env and fill in your key. .env is gitignored.

# ── LLM providers ────────────────────────────────────────────────────────────
# At least one key is required for Q&A. Providers are tried in LLM_PROVIDER_ORDER
# and the first one holding a key answers; if it rate-limits, the next is used.
# OpenAI is first by default because Groq's free tier (8,000 tokens/minute) can
# stall a live demo after a few questions.
OPENAI_API_KEY=your-openai-key-here
# OPENAI_MODEL=gpt-5.5
# OPENAI_SUMMARY_MODEL=gpt-5.5-mini
# OPENAI_BASE_URL=                       # only for Azure/proxy setups
# LLM_PROVIDER_ORDER=openai,groq         # or "groq,openai", or a single name

# Groq's OpenAI-compatible API — kept as the fallback path.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-key-here

# Optional overrides.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
#
# Models must be IDs Groq actually serves — check with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# GROQ_MODEL=openai/gpt-oss-120b          # chat Q&A (larger, more accurate)
# GROQ_SUMMARY_MODEL=openai/gpt-oss-20b   # the six auto-summary cards (cheaper)
# GROQ_REASONING_EFFORT=medium            # low | medium | high
#
# Fire the six summary questions automatically on upload. Off by default:
# each upload would otherwise cost six full-document calls.
# SUMMARY_AUTO_RUN=false
#
# MAX_CONTEXT_TOKENS=150000
